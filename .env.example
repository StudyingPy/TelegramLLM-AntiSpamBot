TELEGRAM_BOT_TOKEN=
DATABASE_PATH=data/bot.db
LOG_LEVEL=INFO

# Comma-separated Telegram user IDs allowed to use private/admin management commands.
ADMIN_USER_IDS=

# Comma-separated admin user IDs to receive private moderation records.
# Leave empty to use ADMIN_USER_IDS.
ADMIN_NOTIFY_USER_IDS=

# Comma-separated group/supergroup chat IDs. If REQUIRE_ALLOWED_CHAT=true, moderation only runs
# in env-allowed chats or chats added by /allow_chat.
ALLOWED_CHAT_IDS=
REQUIRE_ALLOWED_CHAT=true

# Comma-separated domain suffixes that are allowed for first-message links.
WHITELIST_DOMAINS=

# Comma-separated user IDs whose messages bypass moderation completely. Use for
# friendly bots like nmBot (客服酱) whose moderation notifications would otherwise
# be caught by our local rules. Runtime additions can also be managed via
# `antispam-admin whitelist-user <user_id> --note "..."`.
# Note: Telegram's service account 777000 is whitelisted by default (it is the sender
# of linked-channel posts auto-forwarded into the discussion group), so you do not
# need to list it here.
WHITELISTED_USER_IDS=

VOTE_MIN_CONFIRMATIONS=3
# 群内按钮投票的存活时长。超时后消息默认放行，但会在群内投票消息上挂出
# “前往私聊补审”按钮，管理员点击即可进入私聊复审并补充封禁/维持放行。
# 默认 86400 秒（24 小时），给管理员充足的处置窗口。
VOTE_TIMEOUT_SECONDS=86400
VOTE_SWEEP_INTERVAL_SECONDS=60
# 投票超时提示消息（含“前往私聊补审”按钮）在群内的存活时长，到点自动删除。
# 删除后补审的群内入口也随之消失，等于补审窗口 = 该时长。默认 21600 秒（6 小时）。
VOTE_EXPIRED_MESSAGE_TTL_SECONDS=21600
LOW_REPUTATION_THRESHOLD=35
HIGH_REPUTATION_THRESHOLD=80
REPUTATION_BAN_THRESHOLD=20
REPEAT_WINDOW_SECONDS=300
REPEAT_MIN_DISTINCT_SENDERS=3
LLM_FINGERPRINT_INITIAL_WEIGHT=50
VOTE_CONFIRMED_FINGERPRINT_WEIGHT=85
FINGERPRINT_FALSE_POSITIVE_PENALTY=30
# Each hit on a known-spam fingerprint bumps its weight by this much, up to the
# cap. The cap stays below FINGERPRINT_BAN_WEIGHT so repeated hits raise
# confidence without ever auto-banning on their own.
FINGERPRINT_HIT_WEIGHT_INCREMENT=5
FINGERPRINT_HIT_WEIGHT_CAP=80
LLM_BAN_THRESHOLD=0.85

# Optional OpenAI-compatible NewAPI gateway. Leave empty to run in local-only mode.
# For fallback, use comma-separated values. Matching positions are paired; a single key/model
# is reused for all base URLs.
NEWAPI_BASE_URL=
NEWAPI_API_KEY=
NEWAPI_MODEL=gpt-5.4
# NEWAPI_BASE_URLS=https://api-a.example,https://api-b.example
# NEWAPI_API_KEYS=key-a,key-b
# NEWAPI_MODELS=gpt-5.4,gpt-4.1-mini
NEWAPI_TIMEOUT_SECONDS=8
NEWAPI_TEMPERATURE=0
NEWAPI_MAX_TOKENS=600

# OG fetch is triggered for very short messages, or punctuation-only messages, carrying link_preview_options.url.
OG_FETCH_ENABLED=true
OG_SHORT_TEXT_MAX_CHARS=8
OG_FETCH_TIMEOUT_SECONDS=3
OG_FETCH_MAX_BYTES=65536
OG_FETCH_MAX_TEXT_CHARS=1200
OG_FETCH_MAX_REDIRECTS=3

# User profile context. Basic username/display name comes from each message.
# Bio is best-effort because Bot API may not expose it for ordinary group users.
PROFILE_BIO_FETCH_ENABLED=true
PROFILE_BIO_CACHE_TTL_SECONDS=604800
